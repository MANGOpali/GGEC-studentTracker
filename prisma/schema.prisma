generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COUNSELLOR
  RECEPTIONIST
  TEACHER
}

enum LeadType {
  STUDY_ABROAD
  IELTS_CLASS
  PTE_CLASS
  DATE_BOOKING
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  COUNSELLING_BOOKED
  COUNSELLING_COMPLETED
  INTERESTED
  DOCUMENT_COLLECTION
  APPLICATION_STARTED
  APPLICATION_SUBMITTED
  OFFER_RECEIVED
  VISA_PROCESS
  VISA_GRANTED
  ENROLLED
  NOT_INTERESTED
  NOT_ELIGIBLE
  NO_RESPONSE
  FUTURE_INTAKE
  CLOSED
  // IELTS / PTE class statuses
  DEMO_SCHEDULED
  DEMO_ATTENDED
  IN_CLASS
  COMPLETED
  DROPPED
  // Date booking statuses
  CONFIRMED
  RESCHEDULED
  NO_SHOW
}

enum ClassType {
  PHYSICAL
  ONLINE
  CRASH_COURSE
}

enum StudentStatus {
  TRIAL
  ACTIVE
  HOLD
  COMPLETE
  DROPPED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  ONLINE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ActivityType {
  CREATE_LEAD
  UPDATE_LEAD
  ASSIGN_LEAD
  CHANGE_STATUS
  ADD_NOTE
  SCHEDULE_FOLLOWUP
  COMPLETE_COUNSELLING
  ARCHIVE_LEAD
  LOGIN
}

enum SyncStatus {
  SYNCED
  PENDING
  FAILED
}

model Branch {
  id        String   @id @default(cuid())
  name      String   @unique
  location  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users  User[]
  leads  Lead[]
  shifts Shift[]
}

model Shift {
  id        String   @id @default(cuid())
  name      String
  startTime String
  endTime   String
  days      String[]
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads       Lead[]
  attendance  Attendance[]

  @@index([branchId])
  @@index([isActive])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole
  phone     String?
  isActive  Boolean  @default(true)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedLeads Lead[]         @relation("AssignedLeads")
  createdLeads  Lead[]         @relation("CreatedLeads")
  teachingLeads Lead[]         @relation("TeacherLeads")
  activities    LeadActivity[]
  notifications Notification[]
  feeRecords    FeeRecord[]    @relation("FeeCreatedBy")
  payments      Payment[]      @relation("PaymentRecordedBy")
  attendance    Attendance[]   @relation("AttendanceMarkedBy")
}

model LeadSource {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  leads Lead[]
}

model Country {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  leads Lead[]
}

model Intake {
  id        String   @id @default(cuid())
  name      String   @unique
  year      Int?
  month     Int?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  leads Lead[]
}

model Lead {
  id                   String     @id @default(cuid())
  leadId               String     @unique
  studentName          String
  phone                String
  email                String?
  educationLevel       String
  leadType             LeadType   @default(STUDY_ABROAD)
  bookingDate          DateTime?
  countryId            String?
  country              Country?   @relation(fields: [countryId], references: [id])
  course               String?
  intakeId             String?
  intake               Intake?    @relation(fields: [intakeId], references: [id])
  sourceId             String
  source               LeadSource @relation(fields: [sourceId], references: [id])
  referredBy           String?
  branchId             String?
  branch               Branch?    @relation(fields: [branchId], references: [id])
  assignedCounsellorId String?
  assignedCounsellor   User?      @relation("AssignedLeads", fields: [assignedCounsellorId], references: [id])
  teacherId            String?
  teacher              User?      @relation("TeacherLeads", fields: [teacherId], references: [id])
  shiftId              String?
  shift                Shift?     @relation(fields: [shiftId], references: [id])
  classType            ClassType?
  studentStatus        StudentStatus?
  status               LeadStatus @default(NEW)
  academicInfo         Json?
  englishTest          Json?
  notes                String?
  nextFollowUpAt       DateTime?
  lastContactedAt      DateTime?
  followUpNotes        String?
  isArchived           Boolean    @default(false)

  campaign    String?
  campaignId  String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?

  createdById String
  createdBy   User     @relation("CreatedLeads", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activities  LeadActivity[]
  syncLogs    SyncLog[]
  feeRecord   FeeRecord?
  attendance  Attendance[]

  @@index([phone])
  @@index([leadId])
  @@index([studentName])
  @@index([countryId])
  @@index([status])
  @@index([leadType])
  @@index([assignedCounsellorId])
  @@index([teacherId])
  @@index([shiftId])
  @@index([classType])
  @@index([studentStatus])
  @@index([createdAt])
  @@index([isArchived])
}

model FeeRecord {
  id          String    @id @default(cuid())
  leadId      String    @unique
  lead        Lead      @relation(fields: [leadId], references: [id])
  totalFee    Float
  discount    Float     @default(0)
  notes       String?
  createdById String
  createdBy   User      @relation("FeeCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  payments Payment[]

  @@index([leadId])
}

model Payment {
  id           String        @id @default(cuid())
  feeRecordId  String
  feeRecord    FeeRecord     @relation(fields: [feeRecordId], references: [id])
  amount       Float
  method       PaymentMethod @default(CASH)
  reference    String?
  paidAt       DateTime      @default(now())
  notes        String?
  recordedById String
  recordedBy   User          @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime      @default(now())

  @@index([feeRecordId])
  @@index([paidAt])
}

model Attendance {
  id         String           @id @default(cuid())
  leadId     String
  lead       Lead             @relation(fields: [leadId], references: [id])
  shiftId    String
  shift      Shift            @relation(fields: [shiftId], references: [id])
  date       DateTime         @db.Date
  status     AttendanceStatus @default(PRESENT)
  notes      String?
  markedById String
  markedBy   User             @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  createdAt  DateTime         @default(now())

  @@unique([leadId, shiftId, date])
  @@index([leadId])
  @@index([shiftId])
  @@index([date])
}

model LeadActivity {
  id        String       @id @default(cuid())
  leadId    String?
  lead      Lead?        @relation(fields: [leadId], references: [id])
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  action    ActivityType
  metadata  Json?
  createdAt DateTime     @default(now())

  @@index([leadId])
  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  leadId    String?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model IntegrationSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?
  metadata  Json?
  updatedAt DateTime @updatedAt
}

model SyncLog {
  id        String     @id @default(cuid())
  leadId    String
  lead      Lead       @relation(fields: [leadId], references: [id])
  status    SyncStatus
  errorMsg  String?
  syncedAt  DateTime?
  createdAt DateTime   @default(now())

  @@index([leadId])
  @@index([status])
}
